# ===========================================================================
# 换行统一：仓库内一律 LF，检出行为一致，避免整文件 diff 噪音
# ===========================================================================
* text=auto eol=lf

# --- 脚本：按各自平台约定换行 ---------------------------------------------
*.sh   text eol=lf
*.bash text eol=lf
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# --- 二进制：禁止文本转换与 diff ------------------------------------------
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webp       binary
*.avif       binary
*.ico        binary
*.wav        binary
*.mp3        binary
*.ogg        binary
*.woff       binary
*.woff2      binary
*.ttf        binary
*.otf        binary
# 角色模型资源：Spine 历史格式（已从仓库移除，保留标记避免旧文件被当文本）
*.skel       binary
*.atlas      text eol=lf
*.spine      binary

# 说明：Spine 方案已封存，当前管线为帧序列动画。若引入新的模型/图集格式，
# 在此补对应二进制或文本标记。

# --- 生成物：折叠 diff、标注来源 ------------------------------------------
*.lock       linguist-generated
pnpm-lock.yaml linguist-generated

# --- 语言统计守门（即便规则被绕过强行入库，也不污染统计） ------------------
references/**   linguist-vendored
reference/**    linguist-vendored
experiments/**  linguist-vendored
docs/**         linguist-documentation
