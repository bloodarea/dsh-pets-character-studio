# ===========================================================================
# dsh-pets-character-studio 文件卫生规则（machine-enforced）
# 规则正文与理由：CONTRIBUTING.md § 文件卫生规则
# 提交前自检：scripts/verify-hygiene.sh （pre-commit 钩子已挂）
# 修改本文件时请同步 scripts/verify-hygiene.sh 的硬性校验规则。
# ===========================================================================

# --- 1. 本地参考资料：第三方参考项目 / 技术实验与验证脚本 ------------------
# 只在本机保留，永不入库：体积大、多为第三方代码、含实验痕迹与可能的许可证冲突。
# 前导 / 只锚定仓库根：`skills/<name>/references/` 是随包分发的技能资源，不属于此列。
/references/
/reference/
/experiments/
/playground/
/sandbox/

# --- 1b. 本地工作区：部件拆分与运行环境（模型文件） ----------------------
# 只在本机保留：拆件中间产物、模型权重与运行时依赖体积大、可重建，且多为第三方许可。
# 需要长期保留的产出应落 assets/source/（图片 + manifest），工作现场本身不入库。
/workspace/

# --- 1c. workspace 内部细则（整目录已忽略；这里写明各部分的性质与理由）----
# 目的：日后若重命名 / 局部解构工作区，照这份清单逐条搬规则，避免误把大文件与
# 第三方代码提交进来；也让“为什么这些不进库”写在仓里而不是只存在脑子里。
/workspace/models/                      # See-through 等模型权重：GB 级、可重下、第三方许可
/workspace/tools/                       # 第三方工具检出（如 see-through，含其自带 .git）
/workspace/environments/                # 本机 Python / 运行时环境
/workspace/characters/*/parts-bundles/  # 拆件包与问题标注产物（按需打成 release 交付）
/workspace/characters/*/annotation-shots/
/workspace/tmp/                         # 测试脚本、浏览器截图、日志
/workspace/shared/                      # 参考项目与模板（同 §1 的 references 口径）

# --- 2. 内部文档：docs/ 下的文档资源不入库 --------------------------------
# 唯一例外：README 需要引用的图片 / 截图，统一放 docs/assets/，且必须是图片格式。
# 注意：保留目录本身，只忽略其内容，否则 Negation（!）无法生效。
/docs/*
!/docs/assets/
/docs/assets/*
!/docs/assets/*.png
!/docs/assets/*.jpg
!/docs/assets/*.jpeg
!/docs/assets/*.gif
!/docs/assets/*.webp
!/docs/assets/*.svg
!/docs/assets/*.avif

# --- 3. 依赖与构建产物 ----------------------------------------------------
node_modules/
.venv/
.pnpm-store/
dist/
build/
out/
coverage/
.vite/
.turbo/
.cache/
*.tsbuildinfo

# --- 3b. Python 字节码 ------------------------------------------------
__pycache__/
*.py[cod]

# --- 4. 本地运行态、编辑器与系统垃圾 --------------------------------------
.dsh/
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# --- 4b. 测试产物（浏览器截图 / 验收证据）--------------------------------
output/

# --- 5. 日志与临时文件 ----------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
.tmp/
scratch/
*.bak
*.orig
*.rej

# --- 6. 凭据与本地配置（绝不入库） ----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
local.config.json

# --- 7. 人物包：默认只留本地，按包显式放行（插件分发包不带人物包）-------
# 仓库是人物包分发源，但入库包必须是完整、授权已核实的交付包：
# manifest.json + LICENSE + ATTRIBUTION.md + 可用资源，并过卫生脚本复核。
# 未完成或授权待核实的包（如 doubao）只留本地；新增发布包时在这里加一行
# !/assets/characters/<id>/ 显式放行，不要图省事放行整个子目录。
# 同样保留父目录、只忽略内容，否则 Negation（!）无法生效。
/assets/characters/*
!/assets/characters/deepseek/
!/assets/characters/index.json

# --- 8. 项目技能：仅本地使用，不上传远端 ----------------------------------
# DSH 在 <projectRoot>/.agents/skills 发现项目级技能（每技能一个目录含 SKILL.md）。
# 里面常含本机路径与内部工作流，属于工作资产，故整体忽略。
.agents/
