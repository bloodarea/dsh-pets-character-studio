{
  "name": "dsh-pets-character-studio",
  "version": "0.0.1",
  "description": "Character-pack authoring for DSH Pets: PSD part extraction, image-generation completion and frame-sequence animation.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "icon": "./icon.png",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "files": [
    "index.js", "cordis.patch.yml", "locale/*.json", "icon.png", "skills",
    "scripts/*.sh", "requirements.txt"
  ],
  "keywords": ["dsh", "deepseek-harness", "character-pack", "psd", "authoring"]
}
